# Django
DJANGO_SECRET_KEY=替换为随机长字符串
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=你的服务器IP或域名,localhost

# Database
DB_ENGINE=postgresql
DB_NAME=kingdom
DB_USER=kingdom
DB_PASSWORD=替换为强密码
DB_HOST=db
DB_PORT=5432

# CORS（前端域名，逗号分隔）
CORS_ORIGINS=http://你的服务器IP或域名

# AI 点评服务
AI_SERVICE_URL=http://AI服务地址:端口
AI_API_KEY=你的API密钥
AI_REQUEST_TIMEOUT=30
# Village market writes require authenticated Env site actions by default.
# Standalone non-village deployments may explicitly opt into legacy HTTP writes.
VILLAGE_REQUIRE_ENV_MARKET_WRITES=true
# Lucy onboarding quota is separate from ordinary commissions; rewards use Lucy's real wallet.
# Set 0 to temporarily stop new onboarding intake. Default: 20 open/active tutorial orders.
LUCY_TUTORIAL_MAX_OPEN=20

# Player-specific NPC quick phrases (server-side only). Leave key/model empty until configured.
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
NPC_QUICK_INPUT_ENABLED=true
NPC_QUICK_INPUT_INTERVAL_SECONDS=60
NPC_QUICK_INPUT_MIN_NEW_MESSAGES=5
NPC_QUICK_INPUT_QUIET_SECONDS=30
NPC_QUICK_INPUT_COOLDOWN_SECONDS=300
NPC_QUICK_INPUT_TIMEOUT_SECONDS=30
NPC_QUICK_INPUT_BATCH_SIZE=2

# MiMo speech recognition (server-side only)
MIMO_API_KEY=
